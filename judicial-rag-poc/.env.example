# This standalone prototype defaults to local SQLite. Set a PostgreSQL URL when available.
JUDICIAL_DATABASE_URL=sqlite:///./data/judicial.db

# Persistent local Qdrant mode. Set QDRANT_URL to use a server/Cloud deployment later.
JUDICIAL_QDRANT_PATH=./data/qdrant
# JUDICIAL_QDRANT_URL=http://localhost:6333
# JUDICIAL_QDRANT_API_KEY=
JUDICIAL_QDRANT_COLLECTION=judgment_passages

JUDICIAL_OBJECTS_DIR=./data/objects
# Optional S3 or MinIO target. Leave blank for local object storage.
# JUDICIAL_S3_BUCKET=judgments
# JUDICIAL_S3_ENDPOINT_URL=http://localhost:9000
# JUDICIAL_S3_ACCESS_KEY_ID=
# JUDICIAL_S3_SECRET_ACCESS_KEY=

JUDICIAL_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
JUDICIAL_EMBEDDING_DIMENSION=384
JUDICIAL_MAX_CHUNK_WORDS=350
JUDICIAL_CHUNK_OVERLAP_WORDS=50
JUDICIAL_OCR_SCANNED_PDFS=false

# Optional local Ollama for generated answers. Retrieval still works without it.
# JUDICIAL_OLLAMA_URL=http://localhost:11434
# JUDICIAL_OLLAMA_MODEL=llama3.2:3b

